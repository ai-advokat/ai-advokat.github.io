    "public_does_not_mean_reusable",
    "reuse_terms_must_be_recorded",
    "bulk_ingest_fails_closed_when_terms_are_unclear",
    "current_law_requires_version_and_effective_date_verification",
    "court_authority_and_jurisdiction_must_remain_visible",
    "record_level_licenses_control_repository_full_text",
    "personal_data_minimisation_applies_to_case_law",
    "secondary_and_comparative_sources_never_silently_replace_controlling_authority",
    "human_review_required_before_new_source_is_promoted_to_automated_ingest"
  ],
