{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-advokat-staging",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-26",
  "preview_urls": true,

  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFKQHY3Quvb_8JqH",
    "TURNSTILE_ALLOWED_HOSTNAMES": "ai-advokat-staging.aiadvokat16.workers.dev"
  },

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-advokat-db-staging",
      "database_id": "eb560e98-9fc0-408e-9c81-9b823ffde44d",
      "migrations_dir": "migrations"
    }
  ],

  "ai": {
    "binding": "AI"
  }
}
