{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-advokat-github-io",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-26",
  "preview_urls": true,

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-advokat-db",
      "database_id": "12ece285-74bb-4f27-a025-2dbd1be6c59a",
      "migrations_dir": "migrations"
    }
  ],

  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ai-advokat-db-staging",
        "database_id": "eb560e98-9fc0-408e-9c81-9b823ffde44d"
      }
    ]
  }
}
